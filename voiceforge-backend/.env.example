# Server (used by `python main.py`; the start scripts pass their own host/port).
# The API has no authentication, so keep it on 127.0.0.1 unless you trust your network.
HOST=127.0.0.1
PORT=8001
DEBUG=false
SECRET_KEY=change-me-to-a-random-hex-string

# Database
DATABASE_URL=sqlite:///./voiceforge.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_WORKERS=4
MAX_CONCURRENT_DOWNLOADS=3

# Storage (relative paths are resolved against voiceforge-backend/)
OUTPUT_DIR=./static/outputs
TEMP_DIR=./tmp
MAX_OUTPUT_SIZE_GB=50
RETENTION_DAYS=7

# Hugging Face access token (required for speaker diarization with pyannote).
# 1. Accept the terms of https://huggingface.co/pyannote/speaker-diarization-3.1
#    and https://huggingface.co/pyannote/segmentation-3.0
# 2. Create a read token at https://huggingface.co/settings/tokens and paste it here.
HF_TOKEN=

# ML Models
DEMUCS_MODEL=htdemucs_ft
WHISPER_MODEL=large-v3
PYANNOTE_MODEL=pyannote/speaker-diarization-3.1
USE_GPU=auto

# Processing Defaults
DEFAULT_SAMPLE_RATE=22050
DEFAULT_BIT_DEPTH=16
DEFAULT_MIN_CLIP_S=1.5
DEFAULT_MAX_CLIP_S=25.0
DEFAULT_MIN_SNR_DB=15.0
DEFAULT_QUALITY_THRESHOLD=60

# Rate Limiting
ANIDB_DELAY_S=2.5
YOUTUBE_MAX_RESULTS=50
BILIBILI_MAX_RESULTS=30
